# Run npm run setup:local to create .env and a fresh local seed securely.
WALLET_DATABASE_URL=postgresql://wallet:wallet_local_only@127.0.0.1:5432/wallet
BROADCAST_DATABASE_URL=postgresql://broadcast:broadcast_local_only@127.0.0.1:5433/broadcast
LEDGER_DATABASE_URL=postgresql://ledger:ledger_local_only@127.0.0.1:5434/ledger
ACTIVITY_DATABASE_URL=postgresql://activity:activity_local_only@127.0.0.1:5435/activity
SWEEP_DATABASE_URL=postgresql://sweep:sweep_local_only@127.0.0.1:5436/sweep
USER_DATABASE_URL=postgresql://users:users_local_only@127.0.0.1:5437/users
LEDGER_HOST=127.0.0.1
LEDGER_PORT=3010
LEDGER_URL=http://127.0.0.1:3010
REDIS_URL=redis://127.0.0.1:6379
QUEUE_PREFIX=waas
RESET_EPOCH=REPLACE_WITH_RESET_EPOCH
RESET_IN_PROGRESS=
RESET_PREVIOUS_QUEUE_PREFIX=
RESET_PREVIOUS_SUBSCRIPTION=
QUEUE_AUTH_KEY=REPLACE_WITH_RANDOM_32_BYTE_TOKEN
WALLET_API_KEY=REPLACE_WITH_A_DIFFERENT_RANDOM_TOKEN
LEDGER_API_KEY=REPLACE_WITH_A_THIRD_RANDOM_TOKEN
# Internal customer routes use a separate service credential and one custody domain.
EXCHANGE_API_KEY=REPLACE_WITH_A_FOURTH_RANDOM_TOKEN
EXCHANGE_DOMAIN_ID=exchange-development
USER_HOST=127.0.0.1
USER_PORT=3001
USER_HASH_CONCURRENCY=2
USER_REGISTRATION_WINDOW_MS=60000
USER_REGISTRATION_IP_LIMIT=5
USER_REGISTRATION_GLOBAL_LIMIT=30
USER_LOGIN_WINDOW_MS=60000
USER_LOGIN_IP_LIMIT=10
USER_LOGIN_GLOBAL_LIMIT=60
# User alone loads the PKCS8 private key; Wallet only loads the SPKI public key.
# setup:local creates these auth keys separately from the custody seed.
AUTH_TOKEN_PRIVATE_KEY_FILE=./secrets/user-token-private.pem
AUTH_TOKEN_PUBLIC_KEY_FILE=./secrets/user-token-public.pem
AUTH_TOKEN_ISSUER=exchange-user
AUTH_TOKEN_AUDIENCE=exchange-wallet
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
SIGNER_SEED_ID=local-v1
SIGNER_SEED_FILE=./secrets/local.mnemonic
WALLET_HOST=127.0.0.1
WALLET_PORT=3000
ETH_CHAIN_ID=11155111
ETH_RPC_URL=
# Native Bitcoin regtest derivation/signing and RPC identity checks are implemented.
# Supply a local node below; provider certification and exchange execution still gate rollout.
BTC_RPC_URL=
BTC_RPC_USER=
BTC_RPC_PASSWORD=
# Solana Devnet identity. Set both values when selecting another cluster.
SOLANA_GENESIS_HASH=EtWTRABZaYq6iMfeYKouRu166VU2xqa1wcaWoxPkrZBG
SOLANA_RPC_URL=
# Optional per-chain overrides; share this JSON map across wallet, signer, and broadcast.
# EVM network must equal chainId. Bitcoin supports mainnet/regtest; other Bitcoin forks use mainnet.
CHAIN_NETWORKS={"bitcoin":{"network":"regtest","rpcNetwork":"regtest"}}
# CHAIN_NETWORKS={"polygon":{"network":"137","chainId":"137","rpcUrl":"https://polygon-rpc.example"}}
ALLOW_BROADCAST=false
# Native sweep and withdrawal execution are independently opt-in and still requires approved address/asset/provider gates.
ENABLE_NATIVE_SWEEPS=false
ENABLE_NATIVE_WITHDRAWALS=false
# Transfer-only tokens require certified assets, completed token watches and native fee capital.
# Wallet/Sweep/Broadcast execution and private Signer signing are independent opt-in gates.
ENABLE_TOKEN_EXECUTION=false
ENABLE_TOKEN_SIGNING=false
EXECUTION_RECONCILIATION_MS=30000
SWEEP_RECONCILIATION_MS=15000
SWEEP_RETRY_DELAY_MS=60000
EXCHANGE_FINANCIAL_POLICY_VERSION=exchange-financial-v1
# Separate Ed25519 pairs: Wallet authorizes spending; Signer attests exact results.
# setup:local creates these for a fresh setup. For an existing setup use setup:execution-policy.
# Wallet receives authority-private and signer-public only.
EXECUTION_AUTHORITY_PRIVATE_KEY_FILE=./secrets/execution-authority-private.pem
# Signer receives authority-public and signer-private only.
EXECUTION_AUTHORITY_PUBLIC_KEY_FILE=./secrets/execution-authority-public.pem
EXECUTION_SIGNER_PRIVATE_KEY_FILE=./secrets/execution-signer-private.pem
# Wallet and Broadcast receive signer-public; Broadcast receives neither private key.
EXECUTION_SIGNER_PUBLIC_KEY_FILE=./secrets/execution-signer-public.pem

PUBSUB_PROJECT_ID=wallet-local
PUBSUB_TOPIC_BASE=on-chain-activity
PUBSUB_SUBSCRIPTION_BASE=wallet-activity
PUBSUB_TOPIC=on-chain-activity-REPLACE_WITH_EPOCH_SUFFIX
PUBSUB_SUBSCRIPTION=wallet-activity-REPLACE_WITH_EPOCH_SUFFIX
PUBSUB_API_ENDPOINT=127.0.0.1:8086
ACTIVITY_FINALITY_POLL_MS=30000
ACTIVITY_FINALITY_MAX_POLLS=120
ACTIVITY_RECONCILIATION_POLL_MS=300000

# Phase 3 discovery gateway in the separate provider repository, not QuickNode's
# upstream REST URL. Empty certifications keep exchange address readiness disabled.
EXCHANGE_PROVIDER_NAME=quicknode
EXCHANGE_PROVIDER_URL=
EXCHANGE_PROVIDER_API_KEY=
EXCHANGE_PROVIDER_CERTIFICATIONS=[]
# Ethereum readiness requires certified callTracer coverage. Leave disabled until verified.
EXCHANGE_EVM_TRACE_MODE=top-level
# Separate local Bitcoin Core watch/backfill gateway and canonical deposit-verification RPC.
EXCHANGE_BITCOIN_PROVIDER_URL=
EXCHANGE_BITCOIN_PROVIDER_API_KEY=
EXCHANGE_BITCOIN_PROVIDER_CERTIFICATIONS=[]
EXCHANGE_BTC_RPC_URL=
EXCHANGE_BTC_RPC_USER=
EXCHANGE_BTC_RPC_PASSWORD=
EXCHANGE_DEPOSIT_POLL_MS=30000
EXCHANGE_DEPOSIT_RECONCILIATION_MS=300000
EXCHANGE_RECOVERY_INTERVAL_MS=10000

OUTBOX_INTERVAL_MS=500
QUEUE_RETRY_DELAY_MS=1000
CONFIRMATION_POLL_MS=30000
CONFIRMATION_MAX_POLLS=120

# Internal operational monitoring and audit; does not enable spending.
ENABLE_OPERATIONS_MONITORING=false
OPERATIONS_API_KEY=REPLACE_WITH_OPERATIONS_TOKEN
OPERATIONS_ACTOR=operations-service
OPERATIONS_MONITOR_INTERVAL_MS=30000
OPERATIONS_SAMPLE_FRESHNESS_MS=300000
OPERATIONS_MONITOR_BATCH_SIZE=25

# Phase 8: independent exchange rollout gates (same policy on Wallet/Ledger/Sweep/Broadcast).
# closed | dry-run | canary | full. Dry-run never authorizes spending.
EXCHANGE_ROLLOUT_MODE=closed
ENABLE_ADDRESS_ISSUANCE=false
ENABLE_DEPOSIT_CREDIT=false
ENABLE_EXCHANGE_SWEEPS=false
ENABLE_EXCHANGE_WITHDRAWALS=false
# Canary requires one exact domain/chain/network; blank until selected.
EXCHANGE_CANARY_CHAIN=
EXCHANGE_CANARY_NETWORK=
