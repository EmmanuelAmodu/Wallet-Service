{
  "name": "wallet-as-a-service",
  "version": "1.0.0",
  "description": "NestJS wallet, signer, and broadcast services using Prisma, PostgreSQL, Redis/BullMQ, and Trust Wallet Core",
  "scripts": {
    "build": "npm run clean && npm run db:generate && nest build --all && tsc -p tsconfig.tools.json",
    "test": "npm run build && node --test --test-concurrency=1 dist/tests/*.test.js",
    "dev:signer": "npm run db:generate && nest start signer --watch",
    "dev:wallet": "npm run db:generate && nest start wallet --watch",
    "start:signer": "node dist/apps/signer/src/main.js",
    "start:wallet": "node dist/apps/wallet/src/main.js",
    "migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "setup:local": "tsx scripts/setup-local.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write eslint.config.mjs \"{apps,packages,scripts,tests}/**/*.ts\"",
    "format:check": "prettier --check eslint.config.mjs \"{apps,packages,scripts,tests}/**/*.ts\"",
    "db:generate": "prisma generate && prisma generate --config prisma.broadcast.config.ts",
    "dev:broadcast": "npm run db:generate && nest start broadcast --watch",
    "start:broadcast": "node dist/apps/broadcast/src/main.js",
    "queue": "tsx --env-file-if-exists=.env scripts/queue.ts",
    "migrate:wallet": "npm run migrate -- wallet",
    "migrate:broadcast": "npm run migrate -- broadcast",
    "build:wallet": "npm run db:generate && nest build wallet",
    "build:signer": "npm run db:generate && nest build signer",
    "build:broadcast": "npm run db:generate && nest build broadcast",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@trustwallet/wallet-core": "^4.8.4",
    "bullmq": "^6.3.11",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@bitcoinerlab/secp256k1": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.7",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "bitcoinjs-lib": "^7.0.2",
    "eslint": "^10.11.0",
    "ethers": "^6.17.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "typescript-eslint": "^8.71.0"
  },
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "prisma": {
      "mysql2": "3.24.5"
    }
  }
}
