generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/.prisma/broadcast-client"
}

datasource db {
  provider = "postgresql"
}

enum BroadcastTransactionStatus {
  queued
  broadcasting
  submitted
  confirmed
  failed
  attention
}

model Transaction {
  id                    String                     @id @db.Uuid
  snapshot              Json
  status                BroadcastTransactionStatus
  broadcast_generation  Int
  broadcast_attempts    Int                        @default(0)
  revision              Int                        @default(0)
  last_error            String?
  domain_id             String?
  reset_epoch           String?
  operation_id          String?                    @db.Uuid
  attempt_id            String?                    @unique @db.Uuid
  request_digest        String?
  preparation_digest    String?
  observed_block_hash   String?
  observed_block_height String?
  actual_fee_units      String?
  created_at            DateTime                   @default(now()) @db.Timestamptz
  updated_at            DateTime                   @default(now()) @updatedAt @db.Timestamptz

  @@index([operation_id, created_at])
  @@map("transactions")
}

model Outbox {
  id           String    @id @db.Uuid
  queue        String
  dedupe_key   String    @unique
  payload      Json
  available_at DateTime  @default(now()) @db.Timestamptz
  published_at DateTime? @db.Timestamptz
  created_at   DateTime  @default(now()) @db.Timestamptz

  @@index([published_at, available_at])
  @@map("outbox")
}

model Inbox {
  id           String   @id
  processed_at DateTime @default(now()) @db.Timestamptz

  @@map("inbox")
}
