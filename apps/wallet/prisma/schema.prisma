generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum WalletStatus {
  deriving
  ready
  rejected
}

enum WalletTransactionStatus {
  preparing
  signing
  signed
  queued
  broadcasting
  submitted
  confirmed
  failed
  rejected
  attention
}

model Wallet {
  id           String        @id @db.Uuid
  external_id  String
  chain        String
  network      String
  seed_id      String
  account      Int           @default(autoincrement())
  path         String
  address      String?
  status       WalletStatus  @default(deriving)
  last_error   String?
  created_at   DateTime      @default(now()) @db.Timestamptz
  transactions Transaction[]

  @@unique([external_id, chain, network])
  @@unique([seed_id, chain, account])
  @@unique([chain, network, address])
  @@map("wallets")
}

model Transaction {
  id                   String                  @id @db.Uuid
  wallet_id            String                  @db.Uuid
  wallet               Wallet                  @relation(fields: [wallet_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  idempotency_key      String
  request_hash         String
  intent               Json
  prepared             Json?
  signed               Json?
  tx_hash              String?
  status               WalletTransactionStatus
  broadcast_attempts   Int                     @default(0)
  broadcast_generation Int                     @default(0)
  broadcast_revision   Int                     @default(0)
  last_error           String?
  created_at           DateTime                @default(now()) @db.Timestamptz
  updated_at           DateTime                @default(now()) @updatedAt @db.Timestamptz

  @@unique([wallet_id, idempotency_key])
  @@unique([wallet_id], where: raw("\"status\" IN ('preparing', 'signing', 'signed', 'queued', 'broadcasting', 'submitted', 'attention')"), map: "one_pending_per_wallet")
  @@index([created_at], map: "transactions_created_at")
  @@map("transactions")
}

model Outbox {
  id           String    @id @db.Uuid
  queue        String
  dedupe_key   String    @unique
  payload      Json
  available_at DateTime  @default(now()) @db.Timestamptz
  published_at DateTime? @db.Timestamptz
  created_at   DateTime  @default(now()) @db.Timestamptz

  @@index([published_at, available_at])
  @@map("outbox")
}

model Inbox {
  id           String   @id
  processed_at DateTime @default(now()) @db.Timestamptz

  @@map("inbox")
}

// Exchange projections are separate from the legacy wallet API until Phase 1 owns issuance.
model ExchangeWalletRegistry {
  wallet_id             String   @id @db.Uuid
  domain_id             String
  reset_epoch           String
  chain                 String
  network               String
  address               String
  role                  String
  account               Int
  customer_id           String?  @db.Uuid
  hot_wallet_id         String?  @db.Uuid
  registry_revision     Int
  request               Json
  ledger_status         String   @default("pending")
  listener_status       String   @default("pending")
  ledger_ack_revision   Int      @default(0)
  listener_ack_revision Int      @default(0)
  ledger_reason         String?
  listener_reason       String?
  start_cursor          String?
  ready                 Boolean  @default(false)
  created_at            DateTime @default(now()) @db.Timestamptz
  updated_at            DateTime @default(now()) @updatedAt @db.Timestamptz

  @@unique([domain_id, chain, network, address])
  @@map("exchange_wallet_registry")
}

model ExchangeEventReceipt {
  event_id     String   @id @db.Uuid
  payload_hash String
  payload      Json
  created_at   DateTime @default(now()) @db.Timestamptz

  @@map("exchange_event_receipts")
}

model ExchangeOperationProjection {
  operation_id     String   @id @db.Uuid
  domain_id        String
  reset_epoch      String
  customer_id      String?  @db.Uuid
  request_digest   String
  source_type      String
  request          Json
  state            String
  result_revision  Int      @default(0)
  result_revisions Json     @default("{}")
  result           Json?
  created_at       DateTime @default(now()) @db.Timestamptz
  updated_at       DateTime @default(now()) @updatedAt @db.Timestamptz

  @@map("exchange_operation_projections")
}

model ExchangeCustomer {
  customer_id              String                             @id @db.Uuid
  external_id              String                             @unique
  domain_id                String
  reset_epoch              String
  state                    String                             @default("active")
  ledger_status            String                             @default("pending")
  ledger_registry_revision Int                                @default(0)
  created_at               DateTime                           @default(now()) @db.Timestamptz
  updated_at               DateTime                           @default(now()) @updatedAt @db.Timestamptz
  assignments              ExchangeDepositAddressAssignment[]
  deposits                 ExchangeDepositProjection[]

  @@map("exchange_customers")
}

model ExchangeDepositAddressAssignment {
  assignment_id String           @id @db.Uuid
  customer_id   String           @db.Uuid
  customer      ExchangeCustomer @relation(fields: [customer_id], references: [customer_id], onDelete: NoAction, onUpdate: NoAction)
  domain_id     String
  reset_epoch   String
  chain         String
  network       String
  wallet_id     String?          @unique @db.Uuid
  created_at    DateTime         @default(now()) @db.Timestamptz

  @@unique([customer_id, chain, network])
  @@map("exchange_deposit_address_assignments")
}

// A read projection only. Ledger owns balances, credit, and compensating journals.
model ExchangeDepositProjection {
  deposit_id          String           @id @db.Uuid
  customer_id         String           @db.Uuid
  customer            ExchangeCustomer @relation(fields: [customer_id], references: [customer_id], onDelete: NoAction, onUpdate: NoAction)
  domain_id           String
  reset_epoch         String
  wallet_id           String?          @db.Uuid
  chain               String
  network             String
  asset_id            String
  amount              String?
  transaction_hash    String?
  transfer_identity   Json?
  identity_digest     String?
  discovery_revision  Int              @default(0)
  discovery_state     String           @default("unknown")
  discovery_digest    String?
  accounting_revision Int              @default(0)
  accounting_state    String           @default("pending")
  accounting_digest   String?
  ledger_batch_id     String?          @db.Uuid
  deficit_incident_id String?          @db.Uuid
  reason              String?
  created_at          DateTime         @default(now()) @db.Timestamptz
  updated_at          DateTime         @default(now()) @updatedAt @db.Timestamptz

  @@index([customer_id, deposit_id])
  @@map("exchange_deposit_projections")
}
