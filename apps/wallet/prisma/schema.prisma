generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

enum WalletStatus {
  deriving
  ready
  rejected
}

enum WalletCustodyRole {
  legacy
  hot
  management
  customer_deposit
}

enum WalletTransactionStatus {
  preparing
  signing
  signed
  queued
  broadcasting
  submitted
  confirmed
  failed
  rejected
  attention
}

model Wallet {
  id                        String                   @id @db.Uuid
  external_id               String
  chain                     String
  network                   String
  seed_id                   String
  account                   Int                      @default(autoincrement())
  path                      String
  address                   String?
  status                    WalletStatus             @default(deriving)
  last_error                String?
  created_at                DateTime                 @default(now()) @db.Timestamptz
  transactions              Transaction[]
  custody_domain_id         String?
  reset_epoch               String?
  custody_role              WalletCustodyRole        @default(legacy)
  customer_id               String?                  @db.Uuid
  hot_wallet_id             String?                  @db.Uuid
  management_purpose        String?
  active                    Boolean                  @default(true)
  configuration_revision    Int                      @default(0)
  registry_revision         Int                      @default(0)
  published_at              DateTime?                @db.Timestamptz
  derivation_request_id     String?                  @unique @db.Uuid
  derivation_request_digest String?
  custody_domain            CustodyDomain?           @relation(fields: [custody_domain_id, reset_epoch, seed_id], references: [id, reset_epoch, seed_id], onDelete: NoAction, onUpdate: NoAction)
  custody_network           CustodyNetwork?          @relation(fields: [custody_domain_id, chain, network], references: [domain_id, chain, network], onDelete: NoAction, onUpdate: NoAction)
  customer                  ExchangeCustomer?        @relation(fields: [customer_id, custody_domain_id, reset_epoch], references: [customer_id, domain_id, reset_epoch], onDelete: NoAction, onUpdate: NoAction)
  hot_wallet                Wallet?                  @relation("CustodyHotWallet", fields: [hot_wallet_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customer_wallets          Wallet[]                 @relation("CustodyHotWallet")
  management_policy         ManagementWalletPurpose? @relation(fields: [custody_domain_id, chain, network, account, management_purpose], references: [domain_id, chain, network, account, purpose], onDelete: NoAction, onUpdate: NoAction)

  @@unique([external_id, chain, network])
  @@unique([seed_id, chain, account])
  @@unique([chain, network, address])
  @@unique([custody_domain_id, chain, network], where: raw("\"custody_role\" = 'hot' AND \"active\""), map: "one_active_hot_per_custody_network")
  @@unique([custody_domain_id, customer_id, chain, network], where: raw("\"custody_role\" = 'customer_deposit' AND \"active\""), map: "one_active_customer_deposit_wallet")
  @@index([custody_domain_id, custody_role, active])
  @@map("wallets")
}

model CustodyDomain {
  id                     String           @id
  seed_id                String
  reset_epoch            String
  policy_version         String
  configuration_revision Int              @default(1)
  status                 String           @default("active")
  created_at             DateTime         @default(now()) @db.Timestamptz
  wallets                Wallet[]
  networks               CustodyNetwork[]

  @@unique([id, reset_epoch, seed_id])
  @@map("custody_domains")
}

model CustodyNetwork {
  domain_id              String
  chain                  String
  network                String
  native_asset_id        String
  configuration_revision Int                       @default(1)
  enabled                Boolean                   @default(true)
  domain                 CustodyDomain             @relation(fields: [domain_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  wallets                Wallet[]
  assets                 AssetConfiguration[]
  management_purposes    ManagementWalletPurpose[]
  created_at             DateTime                  @default(now()) @db.Timestamptz

  @@id([domain_id, chain, network])
  @@unique([domain_id, chain])
  @@map("custody_networks")
}

model ManagementWalletPurpose {
  domain_id                  String
  chain                      String
  network                    String
  account                    Int
  purpose                    String
  permitted_actions          Json
  maximum_operation_units    String
  maximum_customer_24h_units String
  maximum_domain_24h_units   String
  policy_version             String
  configuration_revision     Int            @default(1)
  custody_network            CustodyNetwork @relation(fields: [domain_id, chain, network], references: [domain_id, chain, network], onDelete: NoAction, onUpdate: NoAction)
  wallets                    Wallet[]
  created_at                 DateTime       @default(now()) @db.Timestamptz

  @@id([domain_id, chain, network, account])
  @@unique([domain_id, chain, network, account, purpose])
  @@map("management_wallet_purposes")
}

model AssetConfiguration {
  domain_id              String
  chain                  String
  network                String
  asset_id               String
  standard               String
  decimals               Int
  symbol                 String
  name                   String
  contract_address       String?
  token_program          String?
  mint                   String?
  observation_enabled    Boolean        @default(false)
  credit_enabled         Boolean        @default(false)
  sweep_enabled          Boolean        @default(false)
  withdrawal_enabled     Boolean        @default(false)
  minimum_credit_units   String
  minimum_sweep_units    String
  maximum_fee_units      String
  policy_version         String
  configuration_revision Int            @default(1)
  transfer_certificate   Json?
  custody_network        CustodyNetwork @relation(fields: [domain_id, chain, network], references: [domain_id, chain, network], onDelete: NoAction, onUpdate: NoAction)
  created_at             DateTime       @default(now()) @db.Timestamptz

  @@id([domain_id, chain, network, asset_id])
  @@map("asset_configurations")
}

model Transaction {
  id                   String                  @id @db.Uuid
  wallet_id            String                  @db.Uuid
  wallet               Wallet                  @relation(fields: [wallet_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  idempotency_key      String
  request_hash         String
  intent               Json
  prepared             Json?
  signed               Json?
  tx_hash              String?
  status               WalletTransactionStatus
  broadcast_attempts   Int                     @default(0)
  broadcast_generation Int                     @default(0)
  broadcast_revision   Int                     @default(0)
  last_error           String?
  created_at           DateTime                @default(now()) @db.Timestamptz
  updated_at           DateTime                @default(now()) @updatedAt @db.Timestamptz
  custody_execution    CustodyExecution?

  @@unique([wallet_id, idempotency_key])
  @@unique([wallet_id], where: raw("\"status\" IN ('preparing', 'signing', 'signed', 'queued', 'broadcasting', 'submitted', 'attention')"), map: "one_pending_per_wallet")
  @@index([created_at], map: "transactions_created_at")
  @@map("transactions")
}

model CustodyExecution {
  id                  String                   @id @db.Uuid
  operation_id        String                   @unique @db.Uuid
  attempt_id          String                   @unique @db.Uuid
  transaction_id      String                   @unique @db.Uuid
  transaction         Transaction              @relation(fields: [transaction_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  domain_id           String
  reset_epoch         String
  customer_id         String                   @db.Uuid
  source_wallet_id    String                   @db.Uuid
  hot_wallet_id       String                   @db.Uuid
  request_digest      String
  plan                Json
  prepared_request    Json?
  preparation_digest  String?
  ledger_intent_ack Boolean @default(false)
  listener_intent_ack Boolean @default(false)
  authorization       Json?
  signer_result       Json?
  principal_units     String?
  maximum_fee_units   String?
  expires_at          DateTime?                @db.Timestamptz
  state               String
  revision            Int                      @default(0)
  settlement_revision Int                      @default(0)
  ledger_ack_revision Int                      @default(0)
  terminal_proof_revision Int                   @default(0)
  ledger_batch_id     String?                  @db.Uuid
  inclusion           Json?
  reversed            Boolean                  @default(false)
  retired_at          DateTime?                @db.Timestamptz
  next_check_at       DateTime                 @default(now()) @db.Timestamptz
  last_error          String?
  created_at          DateTime                 @default(now()) @db.Timestamptz
  updated_at          DateTime                 @default(now()) @updatedAt @db.Timestamptz
  claims              ExecutionResourceClaim[]

  @@unique([source_wallet_id], where: raw("\"retired_at\" IS NULL"), map: "one_active_custody_execution_per_source")
  @@index([next_check_at, id])
  @@map("custody_executions")
}

model ExecutionResourceClaim {
  id           String           @id @db.Uuid
  resource_key String
  execution_id String           @db.Uuid
  execution    CustodyExecution @relation(fields: [execution_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  active       Boolean          @default(true)
  created_at   DateTime         @default(now()) @db.Timestamptz
  released_at  DateTime?        @db.Timestamptz

  @@unique([resource_key], where: raw("\"active\""), map: "one_active_custody_resource_claim")
  @@map("execution_resource_claims")
}

model Outbox {
  id           String    @id @db.Uuid
  queue        String
  dedupe_key   String    @unique
  payload      Json
  available_at DateTime  @default(now()) @db.Timestamptz
  published_at DateTime? @db.Timestamptz
  created_at   DateTime  @default(now()) @db.Timestamptz

  @@index([published_at, available_at])
  @@map("outbox")
}

model Inbox {
  id           String   @id
  processed_at DateTime @default(now()) @db.Timestamptz

  @@map("inbox")
}

// Exchange projections are separate from the legacy wallet API until Phase 1 owns issuance.
model ExchangeWalletRegistry {
  wallet_id             String   @id @db.Uuid
  domain_id             String
  reset_epoch           String
  chain                 String
  network               String
  address               String
  role                  String
  account               Int
  customer_id           String?  @db.Uuid
  hot_wallet_id         String?  @db.Uuid
  registry_revision     Int
  request               Json
  ledger_status         String   @default("pending")
  listener_status       String   @default("pending")
  ledger_ack_revision   Int      @default(0)
  listener_ack_revision Int      @default(0)
  ledger_reason         String?
  listener_reason       String?
  start_cursor          String?
  ready                 Boolean  @default(false)
  created_at            DateTime @default(now()) @db.Timestamptz
  updated_at            DateTime @default(now()) @updatedAt @db.Timestamptz

  @@unique([domain_id, chain, network, address])
  @@map("exchange_wallet_registry")
}

model ExchangeEventReceipt {
  event_id     String   @id @db.Uuid
  payload_hash String
  payload      Json
  created_at   DateTime @default(now()) @db.Timestamptz

  @@map("exchange_event_receipts")
}

model ExchangeOperationProjection {
  operation_id     String   @id @db.Uuid
  domain_id        String
  reset_epoch      String
  customer_id      String?  @db.Uuid
  request_digest   String
  source_type      String
  request          Json
  state            String
  result_revision  Int      @default(0)
  result_revisions Json     @default("{}")
  result           Json?
  created_at       DateTime @default(now()) @db.Timestamptz
  updated_at       DateTime @default(now()) @updatedAt @db.Timestamptz

  @@map("exchange_operation_projections")
}

model ExchangeCustomer {
  customer_id              String                             @id @db.Uuid
  external_id              String                             @unique
  domain_id                String
  reset_epoch              String
  state                    String                             @default("active")
  ledger_status            String                             @default("pending")
  ledger_registry_revision Int                                @default(0)
  created_at               DateTime                           @default(now()) @db.Timestamptz
  updated_at               DateTime                           @default(now()) @updatedAt @db.Timestamptz
  assignments              ExchangeDepositAddressAssignment[]
  deposits                 ExchangeDepositProjection[]
  custody_wallets          Wallet[]

  @@unique([customer_id, domain_id, reset_epoch])
  @@map("exchange_customers")
}

model ExchangeDepositAddressAssignment {
  assignment_id String           @id @db.Uuid
  customer_id   String           @db.Uuid
  customer      ExchangeCustomer @relation(fields: [customer_id], references: [customer_id], onDelete: NoAction, onUpdate: NoAction)
  domain_id     String
  reset_epoch   String
  chain         String
  network       String
  wallet_id     String?          @unique @db.Uuid
  created_at    DateTime         @default(now()) @db.Timestamptz

  @@unique([customer_id, chain, network])
  @@map("exchange_deposit_address_assignments")
}

// A read projection only. Ledger owns balances, credit, and compensating journals.
model ExchangeDepositProjection {
  deposit_id          String           @id @db.Uuid
  customer_id         String           @db.Uuid
  customer            ExchangeCustomer @relation(fields: [customer_id], references: [customer_id], onDelete: NoAction, onUpdate: NoAction)
  domain_id           String
  reset_epoch         String
  wallet_id           String?          @db.Uuid
  chain               String
  network             String
  asset_id            String
  amount              String?
  transaction_hash    String?
  transfer_identity   Json?
  identity_digest     String?
  discovery_revision  Int              @default(0)
  discovery_state     String           @default("unknown")
  discovery_digest    String?
  accounting_revision Int              @default(0)
  accounting_state    String           @default("pending")
  accounting_digest   String?
  ledger_batch_id     String?          @db.Uuid
  deficit_incident_id String?          @db.Uuid
  reason              String?
  created_at          DateTime         @default(now()) @db.Timestamptz
  updated_at          DateTime         @default(now()) @updatedAt @db.Timestamptz

  @@index([customer_id, deposit_id])
  @@map("exchange_deposit_projections")
}

// Wallet owns customer withdrawal intents and their reservation/execution saga.
model Withdrawal {
  id String @id @db.Uuid
  customer_id String @db.Uuid
  domain_id String
  reset_epoch String
  idempotency_key String
  request_digest String
  request Json
  chain String
  network String
  asset_id String
  destination String
  principal_units String
  customer_fee_units String @default("0")
  policy_version String
  hot_wallet_id String @db.Uuid
  hot_registry_revision Int
  reservation_id String? @unique @db.Uuid
  attempt_id String? @unique @db.Uuid
  state String
  reason String?
  cancel_requested Boolean @default(false)
  reservation_revision Int @default(0)
  execution_revision Int @default(0)
  settlement_revision Int @default(0)
  revision Int @default(1)
  next_check_at DateTime @default(now()) @db.Timestamptz
  transaction_hash String?
  created_at DateTime @default(now()) @db.Timestamptz
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz
  @@unique([customer_id, idempotency_key])
  @@index([state, next_check_at, id])
  @@index([customer_id, created_at, id])
  @@map("withdrawals")
}

// Pending and uncertain exposure never expires out of the rolling budget.
model TokenFeeReservation {
  id                    String @id @db.Uuid
  domain_id             String
  reset_epoch           String
  customer_id           String @db.Uuid
  source_wallet_id      String @db.Uuid
  management_wallet_id  String @db.Uuid
  chain                 String
  network               String
  dependency_key        String @unique
  request_digest        String
  kind                  String
  principal_units       String
  maximum_fee_units     String
  maximum_rent_units    String
  reserved_units        String
  actual_units          String?
  state                 String
  request               Json
  settled_at            DateTime? @db.Timestamptz
  created_at            DateTime @default(now()) @db.Timestamptz
  updated_at            DateTime @default(now()) @updatedAt @db.Timestamptz

  @@unique([domain_id, reset_epoch, source_wallet_id, chain, network], where: raw("\"state\" IN ('reserved','uncertain')"), map: "one_pending_token_fee_dependency")
  @@index([domain_id, reset_epoch, chain, network, settled_at])
  @@map("token_fee_reservations")
}

model TokenWalletCoverage {
 readiness_revision Int @default(0)
 wallet_id String @db.Uuid
 asset_id String
 domain_id String
 reset_epoch String
 certificate_digest String
 configuration_revision Int
 registry_revision Int
 generation String @db.Uuid
 ready Boolean @default(false)
 cursor String?
 updated_at DateTime @default(now()) @updatedAt @db.Timestamptz
 @@id([wallet_id,asset_id])
 @@map("token_wallet_coverage")
}

model OperationsRun {
 id String @id @db.Uuid
 sequence BigInt @default(autoincrement()) @unique
 domain_id String
 reset_epoch String
 wallet_id String @db.Uuid
 state String
 evidence Json?
 report Json?
 created_at DateTime @default(now()) @db.Timestamptz
 updated_at DateTime @default(now()) @updatedAt @db.Timestamptz
 @@index([domain_id,reset_epoch,wallet_id,created_at])
 @@map("operations_runs")
}
model OperationsCommand {
 id String @id @db.Uuid
 sequence BigInt @default(autoincrement()) @unique
 domain_id String
 reset_epoch String
 actor String
 reason String
 digest String
 request Json
 state String
 result Json?
 created_at DateTime @default(now()) @db.Timestamptz
 updated_at DateTime @default(now()) @updatedAt @db.Timestamptz
 @@index([domain_id,reset_epoch,created_at])
 @@map("operations_commands")
}
model OperationsAlert {
 id String @id
 domain_id String
 reset_epoch String
 severity String
 state String
 evidence Json
 review Json?
 first_seen_at DateTime @default(now()) @db.Timestamptz
 last_seen_at DateTime @default(now()) @db.Timestamptz
 @@index([domain_id,reset_epoch,state])
 @@map("operations_alerts")
}
model OperationsMetricReport {
 id String @id
 domain_id String
 reset_epoch String
 consumer String
 occurred_at DateTime @db.Timestamptz
 metrics Json
 @@map("operations_metric_reports")
}

model OperationsFundingGate {
 domain_id String
 reset_epoch String
 enabled Boolean @default(true)
 reason String
 updated_at DateTime @default(now()) @updatedAt @db.Timestamptz
 @@id([domain_id,reset_epoch])
 @@map("operations_funding_gates")
}
